<div id="app" data-product-id="<%= productId %>">
  <div v-if="loading" class="flex justify-center py-16">
    <div class="w-8 h-8 border-2 border-bloom-green border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="notFound" class="text-center py-16">
    <p class="text-text-secondary mb-2">找不到此商品</p>
    <a href="/" class="text-bloom-green hover:underline text-sm">回到首頁</a>
  </div>

  <div v-else-if="product">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-text-muted mb-8">
      <a href="/" class="hover:text-text-primary transition-colors">首頁</a>
      <span>/</span>
      <a href="/" class="hover:text-text-primary transition-colors">商品</a>
      <span>/</span>
      <span class="text-text-primary">{{ product.name }}</span>
    </nav>

    <div class="flex flex-col md:flex-row gap-10 md:gap-16">
      <!-- Left: Image -->
      <div class="md:w-1/2">
        <div class="rounded-[2px] overflow-hidden bg-bloom-surface">
          <img :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=600'"
            :alt="product.name" class="w-full aspect-square object-cover" />
        </div>
      </div>

      <!-- Right: Info -->
      <div class="md:w-1/2 flex flex-col justify-start">
        <p v-if="product.category" class="mb-2"
          style="font-size:13px; font-weight:500; color:#8FA68E; letter-spacing:0.04em;">{{ product.category }}</p>
        <h1 class="text-[52px] leading-tight text-text-primary mb-3" style="font-family: 'Cormorant Garamond', serif;">
          {{ product.name }}
        </h1>
        <p class="text-[28px] font-semibold text-text-primary mb-4">NT$ {{ product.price.toLocaleString() }}</p>

        <p class="text-text-secondary text-sm mb-1">
          <span class="text-status-paid-text">&#10003;</span> 尚有 {{ product.stock }} 件
        </p>

        <div class="w-full h-px bg-bloom-border my-5"></div>

        <p class="text-text-secondary leading-relaxed mb-6 text-[15px]">{{ product.description }}</p>

        <!-- Quantity Selector -->
        <div class="flex items-center gap-4 mb-6">
          <div class="flex items-center gap-1">
            <button @click="decrease"
              class="w-10 h-10 flex items-center justify-center bg-bloom-surface border border-bloom-border text-text-secondary text-[18px] hover:bg-bloom-border transition-colors">−</button>
            <span class="w-10 text-center text-[18px] text-text-primary">{{ quantity }}</span>
            <button @click="increase"
              class="w-10 h-10 flex items-center justify-center bg-bloom-surface border border-bloom-border text-text-secondary text-[18px] hover:bg-bloom-border transition-colors">+</button>
          </div>
        </div>

        <button @click="addToCart" :disabled="adding || product.stock <= 0"
          class="w-full bg-bloom-green text-white py-3.5 rounded-[2px] text-sm font-medium hover:bg-bloom-green-hover transition-colors disabled:opacity-40">
          {{ product.stock <= 0 ? '已售完' : '加入購物車' }} </button>

            <!-- Purchase Notes -->
            <div class="mt-6 border border-bloom-border rounded-[2px] p-5">
              <h3 class="font-medium text-text-primary mb-2 text-xs tracking-wide uppercase">購買須知</h3>
              <ul class="text-text-muted text-xs space-y-1.5">
                <li>花材依據季節供應，實際花束可能略有差異</li>
                <li>台北市區可享當日配送服務</li>
                <li>消費滿 NT$ 500 享免運優惠</li>
              </ul>
            </div>
      </div>
    </div>
  </div>
</div>