<div id="app">
  <div class="min-h-[75vh] flex items-center justify-center py-8">
    <div class="bg-white border border-bloom-border rounded-[2px] shadow-sm w-full max-w-md p-10">
      <!-- Brand -->
      <div class="text-center mb-8">
        <h1 class="text-3xl text-bloom-green" style="font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 600;">
          Bloom & Co.
        </h1>
        <p class="text-text-muted text-sm mt-1">歡迎回來</p>
      </div>

      <!-- Tabs -->
      <div class="flex mb-7 bg-bloom-surface rounded-[2px] p-1">
        <button
          @click="activeTab = 'login'; errors = {}"
          class="flex-1 py-2 text-sm font-medium transition-colors rounded-[1px]"
          :class="activeTab === 'login' ? 'bg-white text-text-primary shadow-sm' : 'text-text-secondary hover:text-text-primary'"
        >
          登入
        </button>
        <button
          @click="activeTab = 'register'; errors = {}"
          class="flex-1 py-2 text-sm font-medium transition-colors rounded-[1px]"
          :class="activeTab === 'register' ? 'bg-white text-text-primary shadow-sm' : 'text-text-secondary hover:text-text-primary'"
        >
          註冊
        </button>
      </div>

      <!-- Login Form -->
      <form v-if="activeTab === 'login'" @submit.prevent="handleLogin" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text-primary mb-1.5 uppercase tracking-wide">電子郵件</label>
          <input
            v-model="loginForm.email"
            type="email"
            placeholder="email@example.com"
            class="w-full border border-bloom-border rounded-[2px] px-4 py-2.5 text-sm focus:outline-none focus:border-bloom-green transition-colors"
            :class="{ 'border-red-400': errors.email }"
          />
          <p v-if="errors.email" class="text-red-500 text-xs mt-1">{{ errors.email }}</p>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-xs font-medium text-text-primary uppercase tracking-wide">密碼</label>
            <span class="text-xs text-text-muted cursor-pointer hover:text-text-secondary">忘記密碼？</span>
          </div>
          <input
            v-model="loginForm.password"
            type="password"
            placeholder="••••••••"
            class="w-full border border-bloom-border rounded-[2px] px-4 py-2.5 text-sm focus:outline-none focus:border-bloom-green transition-colors"
            :class="{ 'border-red-400': errors.password }"
          />
          <p v-if="errors.password" class="text-red-500 text-xs mt-1">{{ errors.password }}</p>
        </div>

        <button
          type="submit"
          :disabled="submitting"
          class="w-full bg-bloom-green text-white py-3 rounded-[2px] text-sm font-medium hover:bg-bloom-green-hover transition-colors disabled:opacity-40 mt-2"
        >
          {{ submitting ? '登入中...' : '登入' }}
        </button>

        <p class="text-center text-xs text-text-muted pt-2">
          還沒有帳號？
          <button type="button" @click="activeTab = 'register'; errors = {}" class="text-bloom-green font-medium hover:underline">立即註冊</button>
        </p>
      </form>

      <!-- Register Form -->
      <form v-else @submit.prevent="handleRegister" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text-primary mb-1.5 uppercase tracking-wide">姓名</label>
          <input
            v-model="registerForm.name"
            type="text"
            placeholder="請輸入姓名"
            class="w-full border border-bloom-border rounded-[2px] px-4 py-2.5 text-sm focus:outline-none focus:border-bloom-green transition-colors"
            :class="{ 'border-red-400': errors.name }"
          />
          <p v-if="errors.name" class="text-red-500 text-xs mt-1">{{ errors.name }}</p>
        </div>

        <div>
          <label class="block text-xs font-medium text-text-primary mb-1.5 uppercase tracking-wide">電子郵件</label>
          <input
            v-model="registerForm.email"
            type="email"
            placeholder="email@example.com"
            class="w-full border border-bloom-border rounded-[2px] px-4 py-2.5 text-sm focus:outline-none focus:border-bloom-green transition-colors"
            :class="{ 'border-red-400': errors.email }"
          />
          <p v-if="errors.email" class="text-red-500 text-xs mt-1">{{ errors.email }}</p>
        </div>

        <div>
          <label class="block text-xs font-medium text-text-primary mb-1.5 uppercase tracking-wide">密碼</label>
          <input
            v-model="registerForm.password"
            type="password"
            placeholder="至少 6 個字元"
            class="w-full border border-bloom-border rounded-[2px] px-4 py-2.5 text-sm focus:outline-none focus:border-bloom-green transition-colors"
            :class="{ 'border-red-400': errors.password }"
          />
          <p v-if="errors.password" class="text-red-500 text-xs mt-1">{{ errors.password }}</p>
        </div>

        <button
          type="submit"
          :disabled="submitting"
          class="w-full bg-bloom-green text-white py-3 rounded-[2px] text-sm font-medium hover:bg-bloom-green-hover transition-colors disabled:opacity-40 mt-2"
        >
          {{ submitting ? '註冊中...' : '建立帳號' }}
        </button>

        <p class="text-center text-xs text-text-muted pt-2">
          已有帳號？
          <button type="button" @click="activeTab = 'login'; errors = {}" class="text-bloom-green font-medium hover:underline">立即登入</button>
        </p>
      </form>
    </div>
  </div>
</div>
