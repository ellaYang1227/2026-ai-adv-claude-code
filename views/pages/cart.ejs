<div id="app">
  <h1 class="text-[38px] text-text-primary mb-2" style="font-family: 'Cormorant Garamond', serif; font-weight: 700;">購物車
  </h1>

  <div v-if="loading" class="flex justify-center py-16">
    <div class="w-8 h-8 border-2 border-bloom-green border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="items.length === 0" class="text-center py-16 border border-bloom-border rounded-[2px]">
    <p class="text-text-secondary mb-1">購物車是空的</p>
    <p class="text-text-muted text-sm mb-5">快去挑選喜歡的花束吧！</p>
    <a href="/"
      class="inline-block bg-bloom-green text-white px-6 py-2.5 rounded-[2px] text-sm hover:bg-bloom-green-hover transition-colors">去逛逛</a>
  </div>

  <template v-else>
    <!-- Free shipping banner -->
    <div v-if="total < 500"
      class="border border-bloom-border rounded-[2px] p-3 mb-6 text-sm text-text-secondary text-center bg-bloom-surface">
      再買 NT$ {{ (500 - total).toLocaleString() }} 即可享免運費
    </div>
    <div v-else
      class="border border-bloom-border rounded-[2px] p-3 mb-6 text-sm text-status-paid-text text-center bg-status-paid-bg">
      &#10003; 已達免運門檻！
    </div>

    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Cart Items -->
      <div class="flex-1">
        <div class="border-t border-bloom-border divide-y divide-bloom-border">
          <div v-for="item in items" :key="item.id" class="flex items-center gap-4 py-4">
            <img :src="item.product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=100'"
              :alt="item.product.name" class="w-18 h-18 rounded-[2px] object-cover flex-shrink-0 bg-bloom-surface"
              style="width:72px; height:72px;" />
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-text-primary text-sm truncate">{{ item.product.name }}</h3>
              <p class="text-bloom-green font-semibold text-sm mt-0.5">NT$ {{ item.product.price.toLocaleString() }}</p>
            </div>

            <!-- Quantity Controls -->
            <div class="flex items-center gap-1">
              <button @click="updateQuantity(item.id, item.quantity - 1)" :disabled="item.quantity <= 1"
                class="w-8 h-8 flex items-center justify-center bg-bloom-surface border border-bloom-border text-text-secondary text-sm disabled:opacity-40 disabled:cursor-not-allowed hover:bg-bloom-border transition-colors">−</button>
              <span class="w-8 text-center text-sm text-text-primary">{{ item.quantity }}</span>
              <button @click="updateQuantity(item.id, item.quantity + 1)"
                :disabled="item.quantity >= item.product.stock"
                class="w-8 h-8 flex items-center justify-center bg-bloom-surface border border-bloom-border text-text-secondary text-sm disabled:opacity-40 disabled:cursor-not-allowed hover:bg-bloom-border transition-colors">+</button>
            </div>

            <p class="hidden sm:block text-text-primary font-medium text-sm w-24 text-right">
              NT$ {{ (item.product.price * item.quantity).toLocaleString() }}
            </p>

            <button @click="confirmDelete(item.id)"
              class="text-text-muted hover:text-red-500 transition-colors text-lg ml-1">
              &#10005;
            </button>
          </div>
        </div>
      </div>

      <!-- Summary -->
      <div class="lg:w-80">
        <div class="bg-bloom-surface border border-bloom-border rounded-[2px] p-6 sticky top-24">
          <h2 class="font-semibold text-text-primary mb-4 text-sm tracking-wide">訂單摘要</h2>
          <div class="space-y-2 text-sm mb-4">
            <div class="flex justify-between">
              <span class="text-text-secondary">商品小計</span>
              <span class="text-text-primary">NT$ {{ total.toLocaleString() }}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-text-secondary">運費</span>
              <span class="text-text-primary">{{ total >= 500 ? '免運' : 'NT$ 150' }}</span>
            </div>
          </div>
          <div class="border-t border-bloom-border pt-4 flex justify-between items-center mb-5">
            <span class="font-semibold text-text-primary">合計</span>
            <span class="font-semibold text-lg text-bloom-green">
              NT$ {{ (total + (total >= 500 ? 0 : 150)).toLocaleString() }}
            </span>
          </div>
          <button @click="goCheckout"
            class="w-full bg-bloom-green text-white py-3 rounded-[2px] text-sm font-medium hover:bg-bloom-green-hover transition-colors">
            前往結帳
          </button>
        </div>
      </div>
    </div>
  </template>

  <!-- Confirm Dialog -->
  <div v-if="confirmVisible" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40" @click="confirmVisible = false"></div>
    <div class="relative bg-white rounded-[2px] shadow-xl w-full max-w-sm mx-4 p-6 text-center">
      <h3 class="text-lg font-semibold text-text-primary mb-2">確認移除</h3>
      <p class="text-text-secondary text-sm mb-6">確定要從購物車中移除這個商品嗎？</p>
      <div class="flex gap-3 justify-center">
        <button @click="confirmVisible = false"
          class="px-5 py-2 text-sm rounded-[2px] border border-bloom-border text-text-secondary hover:bg-bloom-surface">取消</button>
        <button @click="handleDelete"
          class="px-5 py-2 text-sm rounded-[2px] bg-red-500 text-white hover:bg-red-600">確認移除</button>
      </div>
    </div>
  </div>
</div>